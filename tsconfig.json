{
  "compilerOptions": {
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "target": "ES2017",
    "module": "commonjs",
    "baseUrl": ".",
    "paths": {
      "pedigree/*": ["src/script/*"],
      "vendor/*": ["public/vendor/*"]
    }
  },
  "include": ["src/script/**/*", "src/types/**/*"]
}
